// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Brand {
  id       Int      @id @default(autoincrement())
  name     String   @unique
  products Product[]
}

model Product {
  id          String   @id @default(uuid())
  brandId     Int
  brand       Brand    @relation(fields: [brandId], references: [id])

  name        String
  model       String?
  sku         String   @unique
  category    ProductCategory?
  rawCategory String? 
  gender      String?
  description String?
  imageUrl    String?

  offers      Offer[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([brandId])
  @@index([sku])
}

model Offer {
  id                 String   @id @default(uuid())
  productId          String
  retailer           Retailer
  productUrl         String
  affiliateUrl       String?

  price              Float?
  currency           String?      // Offer currency should override product currency
  availability       Availability?

  priceSource        DataSource?
  imageSource        DataSource?
  sourceProductId    String?

  lastPriceUpdate    DateTime?
  lastScrapedAt      DateTime?

  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([productId])
  @@index([retailer])
  @@unique([productId, retailer])
}

enum Retailer {
  GOAT
  STOCKX
  ADIDAS
  NIKE
}

enum Availability {
  IN_STOCK
  OUT_OF_STOCK
  LIMITED
  UNKNOWN
}

enum DataSource {
  API
  SCRAPE
  CACHE
}

enum ProductCategory {
  SHOES
  APPAREL
  OTHER
}
